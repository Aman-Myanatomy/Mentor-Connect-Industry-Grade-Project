NODE_ENV=development
PORT=8080
DATABASE_URL=mongodb://127.0.0.1:27017/mentor-connect
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=https://code-sandbox-bundler.myanatomy.in
# Leave GEMINI_API_KEY empty to run AI features in MOCK mode (no network, no cost)
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash
SEED_MENTOR_PASSWORD=Mentor-2026-demo
# Dev only: if a mentor is offline, their AI persona replies (marked 'AI')
DEMO_AUTO_REPLY=true
