{
  "name": "mentor-connect-back-end",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "env-cmd -f .env nodemon",
    "build": "tsc -p tsconfig.build.json && npm run copy-assets",
    "copy-assets": "mkdir -p dist/ai && cp -R ai/knowledge-base dist/ai/",
    "start": "env-cmd -f .env nodemon",
    "typecheck": "tsc --noEmit",
    "test:smoke": "env-cmd -f .env tsx tests/smoke.test.ts",
    "seed:demo": "env-cmd -f .env tsx seeds/seed-demo-students.ts"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "env-cmd": "^11.0.0",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.5",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.13.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
